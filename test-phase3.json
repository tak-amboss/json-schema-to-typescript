{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TestPhase3",
  "type": "object",
  "properties": {
    "field": {
      "anyOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/Base" },
            {
              "properties": {
                "root": {
                  "properties": {
                    "children": {
                      "type": "array",
                      "items": {
                        "$dynamicAnchor": "fieldTypes",
                        "oneOf": [
                          { "$ref": "#/$defs/NodeA" },
                          { "$ref": "#/$defs/NodeB" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "Base": {
      "type": "object",
      "properties": {
        "root": {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {}
            }
          }
        }
      }
    },
    "NodeA": {
      "$dynamicAnchor": "fieldTypes",
      "type": "object",
      "properties": {
        "type": { "const": "nodeA" },
        "children": {
          "type": "array",
          "items": { "$dynamicRef": "#fieldTypes" }
        }
      }
    },
    "NodeB": {
      "$dynamicAnchor": "fieldTypes",
      "type": "object",
      "properties": {
        "type": { "const": "nodeB" }
      }
    }
  }
}

