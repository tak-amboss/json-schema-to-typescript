{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TestPhase3Constraints",
  "type": "object",
  "properties": {
    "constrainedField": {
      "anyOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/Base" },
            {
              "properties": {
                "root": {
                  "properties": {
                    "children": {
                      "type": "array",
                      "items": {
                        "$dynamicAnchor": "constrainedTypes",
                        "oneOf": [
                          {
                            "allOf": [
                              { "$ref": "#/$defs/HeadingNode" },
                              {
                                "properties": {
                                  "tag": { "enum": ["h2", "h3"] }
                                }
                              }
                            ]
                          },
                          { "$ref": "#/$defs/TextNode" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "Base": {
      "type": "object",
      "properties": {
        "root": {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {}
            }
          }
        }
      }
    },
    "HeadingNode": {
      "$dynamicAnchor": "constrainedTypes",
      "type": "object",
      "properties": {
        "type": { "const": "heading" },
        "tag": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$dynamicRef": "#constrainedTypes" }
        }
      }
    },
    "TextNode": {
      "$dynamicAnchor": "constrainedTypes",
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      }
    }
  }
}

